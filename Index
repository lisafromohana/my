<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ohana Portal</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            overflow: hidden; /* Prevents double scrollbars */
        }
        iframe {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>
<body>

    <iframe 
        src="https://script.google.com/macros/s/AKfycbxwcMH5irlMuFX9xCryU5WVzcHutwTWV768pk0dsGKYs0tfA4daxwNC-tSHw0HWXwkV/exec" 
        allowfullscreen="true">
    </iframe>

    <script>
        // Optional: Attempt to request fullscreen on load if supported by browser policy
        window.onload = function() {
            const iframe = document.querySelector('iframe');
            iframe.requestFullscreen().catch((err) => {
                console.log(`Note: Fullscreen requires user interaction: ${err.message}`);
            });
        };
    </script>

</body>
</html>
